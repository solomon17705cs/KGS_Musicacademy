rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'staff';
    }

    function isStaffOrAdmin() {
      return isAdmin() || isStaff();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParentOf(studentData) {
      return isSignedIn() && (
        studentData.father_phone == request.auth.token.phone_number ||
        studentData.mother_phone == request.auth.token.phone_number ||
        studentData.father_email == request.auth.token.email ||
        studentData.mother_email == request.auth.token.email
      );
    }

    match /profiles/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isStaffOrAdmin() || isParentOf(resource.data);
      allow write: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    match /attendance_records/{recordId} {
      allow read: if isStaffOrAdmin() ||
        (isSignedIn() &&
         get(/databases/$(database)/documents/students/$(resource.data.student_id))
           .data.father_phone == request.auth.token.phone_number) ||
        (isSignedIn() &&
         get(/databases/$(database)/documents/students/$(resource.data.student_id))
           .data.mother_phone == request.auth.token.phone_number) ||
        (isSignedIn() &&
         get(/databases/$(database)/documents/students/$(resource.data.student_id))
           .data.father_email == request.auth.token.email) ||
        (isSignedIn() &&
         get(/databases/$(database)/documents/students/$(resource.data.student_id))
           .data.mother_email == request.auth.token.email);
      allow write: if isStaffOrAdmin();
    }

    match /fee_payments/{paymentId} {
      allow read: if isStaffOrAdmin() ||
        (isSignedIn() &&
         get(/databases/$(database)/documents/students/$(resource.data.student_id))
           .data.father_phone == request.auth.token.phone_number) ||
        (isSignedIn() &&
         get(/databases/$(database)/documents/students/$(resource.data.student_id))
           .data.mother_phone == request.auth.token.phone_number);
      allow write: if isStaffOrAdmin();
    }

    match /progress_records/{recordId} {
      allow read: if isStaffOrAdmin() ||
        (isSignedIn() &&
         get(/databases/$(database)/documents/students/$(resource.data.student_id))
           .data.father_phone == request.auth.token.phone_number) ||
        (isSignedIn() &&
         get(/databases/$(database)/documents/students/$(resource.data.student_id))
           .data.mother_phone == request.auth.token.phone_number);
      allow write: if isStaffOrAdmin();
    }

    match /notifications/{notificationId} {
      allow read:   if isStaffOrAdmin() ||
                       resource.data.userId == request.auth.uid;
      allow create: if isStaffOrAdmin();
      allow update: if resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /push_tokens/{tokenId} {
      allow read, write: if isSignedIn();
    }

    match /unpaid_class_records/{recordId} {
      allow read: if isStaffOrAdmin() ||
        (isSignedIn() &&
         get(/databases/$(database)/documents/students/$(resource.data.student_id))
           .data.mother_phone == request.auth.token.phone_number) ||
        (isSignedIn() &&
         get(/databases/$(database)/documents/students/$(resource.data.student_id))
           .data.father_phone == request.auth.token.phone_number);
      allow write: if isStaffOrAdmin();
    }

    match /bills/{billId} {
      allow read, write: if isStaffOrAdmin();
    }

    match /bill_audit_logs/{logId} {
      allow read, write: if isStaffOrAdmin();
    }

    match /bill_counters/{year} {
      allow read, write: if isStaffOrAdmin();
    }

    match /compensation_audit/{logId} {
      allow read, write: if isStaffOrAdmin();
    }
  }
}
